# Supabase project settings — find these in Project Settings > API.
# Copy this file to .env.local and fill in real values; .env.local stays untracked.

# Public — safe to expose in the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret — server-side only (Route Handlers, Server Actions). Never prefix
# with NEXT_PUBLIC_ or import it into a Client Component.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic Claude API key — console.anthropic.com. Server-side only, used
# exclusively by app/api/ares/route.ts. Never expose to the browser.
ANTHROPIC_API_KEY=

# Google Calendar OAuth — console.cloud.google.com (OAuth 2.0 Client ID,
# Web application). Server-side only. Redirect URI must exactly match what's
# registered in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
