# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local-machine clutter that lives inside this folder but isn't part of the app
/Microsoft VS Code/
/DESIGN IDEAS/
*.lnk

# local Claude Code session state, not project config
.claude/settings.local.json

# source/reference images (incl. a copyrighted movie still) — not used by
# the app at runtime, only public/ares/face.jpg is
/public/Ares/Face/
/public/ares/Face/

# original uploaded copy of the business hero — not used at runtime, only
# public/business/hero.webp is (same Windows-casing pitfall as ares/Face —
# a broader /public/Business/ rule here previously swallowed hero.webp too)
/public/business/Inseln/
